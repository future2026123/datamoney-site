/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/tools/*
  Cache-Control: public, max-age=3600

# Revalidate the tool pages so updated calculators and their assumptions appear promptly.
/tools/
  Cache-Control: no-cache

/tools/etf_calculator/
  Cache-Control: no-cache

/tools/tax_simulator/
  Cache-Control: no-cache

/tools/dividend_calculator/
  Cache-Control: no-cache

/tools/*/embed.html
  Cache-Control: no-cache

/tools/*/embed
  Cache-Control: no-cache

# Revalidate the test document so updated characters appear promptly.
/tools/investor-type/
  Cache-Control: no-cache

/robots.txt
  Cache-Control: no-cache

/comment-admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/account/result/*
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow

/blog/speech-manifests/*
  Cache-Control: no-cache
  X-Robots-Tag: noindex, nofollow
